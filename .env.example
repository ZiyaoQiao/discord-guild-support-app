APP_ID=<YOUR_APPLICATION_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>

# Optional: use guild-scoped commands during development because they update quickly.
GUILD_ID=<YOUR_TEST_GUILD_ID>

# Optional: support requests will be posted here when configured.
SUPPORT_CHANNEL_ID=<YOUR_SUPPORT_CHANNEL_ID>
# Optional: /schedule posts recruiting messages here. If omitted, the bot finds the channel by name.
GROUP_RECRUITING_CHANNEL_ID=<YOUR_GROUP_RECRUITING_CHANNEL_ID>
GROUP_RECRUITING_CHANNEL_NAME=group-recruiting

# Optional: local JSON storage directory, including pending schedule reminders.
DATA_DIR=.data

# Optional: override the Traditional Chinese official news page if the site changes.
WWM_OFFICIAL_NEWS_URL=https://www.wherewindsmeetgame.com/hmt/news/index.html

# Optional: compatible with LibreTranslate-style POST /translate APIs.
# Request body: { q, source, target, format, api_key? }
TRANSLATE_API_URL=<YOUR_TRANSLATE_API_URL>
TRANSLATE_API_KEY=<YOUR_TRANSLATE_API_KEY>

# Optional: auto-react when a configured user sends a guild message.
# The bot needs View Channels, Read Message History, and Add Reactions permissions.
# Only this role can edit rules through /auto-reaction.
# MESSAGE_REACTION_ADMIN_ROLE_ID=<ROLE_ID>
# MESSAGE_REACTION_USER_ID=<TARGET_USER_ID>
# MESSAGE_REACTION_EMOJI=🔥
# Optional: restrict auto-reactions to specific channels.
# MESSAGE_REACTION_CHANNEL_IDS=<CHANNEL_ID_1>,<CHANNEL_ID_2>
# Optional: multiple rules. Custom emoji can be "<:name:id>" or "name:id".
# MESSAGE_REACTION_RULES=[{"userId":"123","emoji":"👍"},{"userId":"456","emoji":"<:wwm:1234567890>"}]

PORT=3000
