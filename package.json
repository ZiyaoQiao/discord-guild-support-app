{
  "name": "discord-guild-support-app",
  "private": true,
  "version": "0.1.0",
  "description": "Starting point for a Where Winds Meet guild Discord support app.",
  "type": "module",
  "main": "src/app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "register": "node src/commands.js",
    "test": "node --test",
    "check": "find src test -name '*.js' -exec node --check {} \\;"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord-interactions": "^4.0.0",
    "discord.js": "14.27.0",
    "dotenv": "^16.0.3",
    "express": "^4.22.2",
    "opusscript": "0.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "overrides": {
    "body-parser": "1.20.6"
  }
}
